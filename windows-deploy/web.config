<?xml version="1.0" encoding="UTF-8"?>
<!--
    web.config pour Laravel 11 sur IIS (Windows Server 2019)
    Placer ce fichier dans le dossier public\ du projet Laravel
    
    Prérequis: Module IIS URL Rewrite installé
    https://www.iis.net/downloads/microsoft/url-rewrite
-->
<configuration>
    <system.webServer>
        <!-- Gestionnaire PHP FastCGI -->
        <handlers>
            <add name="PHP82_FastCGI" path="*.php" verb="*"
                 modules="FastCgiModule"
                 scriptProcessor="C:\PHP82\php-cgi.exe"
                 resourceType="Either"
                 requireAccess="Script" />
        </handlers>

        <!-- Redirection Laravel: tout vers index.php sauf fichiers/dossiers existants -->
        <rewrite>
            <rules>
                <rule name="Laravel Routes" stopProcessing="true">
                    <match url="^(.*)$" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" />
                </rule>
            </rules>
        </rewrite>

        <!-- Pages d'erreur personnalisées -->
        <httpErrors errorMode="Detailed" />

        <!-- Headers de sécurité -->
        <httpProtocol>
            <customHeaders>
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-XSS-Protection" value="1; mode=block" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
            </customHeaders>
        </httpProtocol>

        <!-- Cache statique -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
            <mimeMap fileExtension=".vue" mimeType="text/javascript" />
        </staticContent>

        <!-- Compression -->
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />

        <!-- Taille maximale des uploads (10 Mo) -->
        <security>
            <requestFiltering>
                <requestLimits maxAllowedContentLength="10485760" />
            </requestFiltering>
        </security>
    </system.webServer>

    <!-- PHP settings via IIS -->
    <system.web>
        <httpRuntime maxRequestLength="10240" />
    </system.web>
</configuration>
